# Frends Platform API credentials
# The Platform API must be enabled on your tenant first (Entra ID app registration
# + Administrator app role + IP allowlisting via Frends support). See:
# https://docs.frends.com/reference/frends-platform-api/how-to-enable-frends-platform-api

# Tenant (Control Panel is https://<tenant>.frendsapp.com)
FRENDS_TENANT=yourtenant
# Optional: override the full base URL if your tenant URL is non-standard
# FRENDS_API_BASE_URL=https://yourtenant.frendsapp.com

# Azure AD / Entra ID OAuth2 client-credentials
FRENDS_AZURE_TENANT=yourorg.onmicrosoft.com
FRENDS_CLIENT_ID=app_registration_application_client_id
FRENDS_CLIENT_SECRET=app_registration_client_secret
FRENDS_APPLICATION_URI=api://your-application-id-uri

# Agent Group IDs (find via Control Panel or frends-agentgroups.sh)
FRENDS_DEV_AGENT_GROUP_ID=
FRENDS_TEST_AGENT_GROUP_ID=
FRENDS_PROD_AGENT_GROUP_ID=

# Environment IDs (used when setting Environment Variable values)
FRENDS_DEV_ENVIRONMENT_ID=
FRENDS_TEST_ENVIRONMENT_ID=
FRENDS_PROD_ENVIRONMENT_ID=

# Defaults
FRENDS_TARGET_FRAMEWORK=net8.0
FRENDS_VERIFY_SSL=true

# Optional: curl timeout (seconds) and activity logging
# FRENDS_TIMEOUT=120
# FRENDS_COMPANION_LOG_ACTIVITY=1
